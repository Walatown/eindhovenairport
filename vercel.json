{
  "rewrites": [
    {
      "source": "/ein-api/:path*",
      "destination": "/api/ein-api?path=:path*"
    },
    {
      "source": "/adsb/:path*",
      "destination": "/api/adsb?path=:path*"
    }
  ],
  "functions": {
    "api/adsb.js": {
      "memory": 512,
      "maxDuration": 10
    },
    "api/ein-api.js": {
      "memory": 512,
      "maxDuration": 10
    }
  }
}
