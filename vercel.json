{
  "rewrites": [
    {
      "source": "/adsb/:path*",
      "destination": "/api/adsb/:path*"
    },
    {
      "source": "/ein-api/:path*",
      "destination": "/api/ein-api/:path*"
    }
  ],
  "functions": {
    "api/adsb/[...path].js": {
      "maxDuration": 10
    },
    "api/ein-api/[...path].js": {
      "maxDuration": 10
    }
  }
}
